# Names only. No values. CLUSTER selects devnet (default) or mainnet.
# SOLANA_RPC_URL_DEVNET: public devnet RPC. NOWNodes has no devnet host.
# SOLANA_RPC_URL_MAINNET: https://sol.nownodes.io (api-key header is NOWNODES_API_KEY).
# SOLANA_RPC_URL_LOCALNET: local validator, if you are not using LiteSVM.
CLUSTER=devnet
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_MAINNET=
SOLANA_RPC_URL_LOCALNET=
NOWNODES_API_KEY=
JUPITER_API_KEY=
PYTH_API_KEY=
HALAL_TERMINAL_API_KEY=
LLM_API_KEY=
PROGRAM_ID=
KEEPER_KEYPAIR=
ADMIN_KEYPAIR=
CHAIN_SELECTOR=
FORWARDER_PROGRAM=
FORWARDER_STATE=
USDC_MINT=
CRE_ETH_PRIVATE_KEY=
CRE_SOLANA_PRIVATE_KEY=
CRE_SOLANA_PRIVATE_KEY_TEST=
