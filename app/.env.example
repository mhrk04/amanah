# Server-only. CLUSTER is not a secret; the RPC URLs and keys are.
# NEXT_PUBLIC_CLUSTER may be devnet or mainnet so the UI can label the network.
# Do not put API keys in NEXT_PUBLIC_* variables.
CLUSTER=devnet
NEXT_PUBLIC_CLUSTER=devnet
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_MAINNET=
NOWNODES_API_KEY=
PYTH_API_KEY=
HALAL_TERMINAL_API_KEY=
LLM_API_KEY=
PROGRAM_ID=
